        },
        {
          "t": 4656,
          "kind": "msg",
          "text": "message_end  role=assistant  \"FOLLOW_UP_GREEN\""
        },
        {
          "t": 4658,
          "kind": "stop",
          "text": "omp_stop  — settlement confirmed via omp_status.state.isSettled"
